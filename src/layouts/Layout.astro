---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'es';
}

const {
  title = 'SDD-CLI | Spec-Driven Development CLI for AI-Assisted Engineering',
  description = 'Stop vibe-coding. Put checkpoints where humans decide before agents write code. The deterministic framework for AI coding workflows.',
  lang = 'en'
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth overflow-x-hidden w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/sdd-logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/sdd-logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-sdd-bg text-sdd-text font-sans antialiased min-h-screen flex flex-col selection:bg-sdd-accent/20 selection:text-sdd-accent overflow-x-hidden w-full relative">
    <!-- Subtle top glow -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-64 bg-gradient-to-b from-sdd-accent/10 to-transparent pointer-events-none -z-10 blur-3xl opacity-60"></div>
    
    <Navbar lang={lang} />
    
    <main class="flex-grow w-full max-w-full overflow-x-hidden">
      <slot />
    </main>
    
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #0D1117;
  }
  ::-webkit-scrollbar-thumb {
    background: #30363D;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #8B949E;
  }

  code, pre {
    font-family: 'JetBrains Mono Variable', monospace;
  }

  pre {
    max-width: 100%;
    overflow-x: auto;
    white-space: pre;
    word-break: normal;
    overflow-wrap: normal;
  }

  /* Prevent table and generic elements from breaking grid track on mobile */
  table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
</style>
