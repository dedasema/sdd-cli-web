---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';
const year = new Date().getFullYear();
---

<footer class="bg-sdd-bg border-t border-sdd-border py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <img src="/sdd-logo.svg" alt="SDD Logo" class="w-6 h-6" />
        <div class="flex items-baseline">
          <span class="font-mono font-bold text-sdd-text text-sm">SDD</span>
          <span class="font-sans font-light text-xs text-sdd-muted ml-1">CLI</span>
        </div>
        <span class="text-xs text-sdd-muted font-mono ml-3 border-l border-sdd-border pl-3">
          Spec-Driven Development Framework
        </span>
      </div>

      <div class="flex items-center gap-6 text-xs font-mono text-sdd-muted">
        <a href="https://github.com/dedasema/sdd-cli" target="_blank" rel="noopener noreferrer" class="hover:text-sdd-text transition-colors">
          GitHub
        </a>
        <a href="https://github.com/dedasema/sdd-cli/releases" target="_blank" rel="noopener noreferrer" class="hover:text-sdd-text transition-colors">
          Releases
        </a>
        <a href="https://github.com/dedasema/sdd-cli/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="hover:text-sdd-text transition-colors">
          MIT License
        </a>
      </div>

      <div class="text-xs text-sdd-muted font-sans text-center md:text-right">
        <span>© {year} SDD-CLI. {isEs ? 'Creado para ingeniería de software con agentes.' : 'Built for deterministic agentic software engineering.'}</span>
      </div>
    </div>
  </div>
</footer>
