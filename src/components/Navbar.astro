---
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';
const homeHref = isEs ? '/es/' : '/';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-sdd-bg/85 border-b border-sdd-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo & Brand Wordmark -->
    <a href={homeHref} class="flex items-center gap-3 group focus:outline-none">
      <img src="/sdd-logo.svg" alt="SDD Logo" class="w-8 h-8 group-hover:scale-105 transition-transform duration-200" />
      <div class="flex items-baseline">
        <span class="font-mono font-extrabold text-xl text-sdd-text tracking-tight group-hover:text-sdd-accent transition-colors">SDD</span>
        <span class="font-sans font-light text-lg text-sdd-muted ml-1 tracking-wider">CLI</span>
      </div>
      <span class="hidden sm:inline-block ml-2 px-2 py-0.5 text-[10px] font-mono rounded-full bg-sdd-elevated border border-sdd-border text-sdd-accent">v0.5.0</span>
    </a>

    <!-- Nav Links -->
    <nav class="flex items-center gap-6">
      <a href="#features" class="hidden md:inline-block text-sm text-sdd-muted hover:text-sdd-text transition-colors">
        {isEs ? '¿Por qué SDD?' : 'Why SDD?'}
      </a>
      <a href="#lifecycle" class="hidden md:inline-block text-sm text-sdd-muted hover:text-sdd-text transition-colors">
        {isEs ? 'Ciclo de 7 Fases' : '7-Phase Cycle'}
      </a>
      <a href="#docs" class="text-sm text-sdd-muted hover:text-sdd-text transition-colors">
        {isEs ? 'Documentación' : 'Docs'}
      </a>
      <a href="#slash-commands" class="hidden sm:inline-block text-sm text-sdd-muted hover:text-sdd-text transition-colors">
        {isEs ? 'Comandos Slash' : 'Slash Commands'}
      </a>
      
      <!-- GitHub link -->
      <a
        href="https://github.com/dedasema/sdd-cli"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sdd-muted hover:text-sdd-text transition-colors p-1.5 rounded-md hover:bg-sdd-elevated"
        aria-label="GitHub Repository"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- Language Switcher -->
      <LanguageSwitcher currentLang={lang} />
    </nav>
  </div>
</header>
