---
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';
const homeHref = isEs ? '/es/' : '/';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-sdd-bg/85 border-b border-sdd-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo & Brand Wordmark -->
    <a href={homeHref} class="flex items-center gap-3 group focus:outline-none">
      <img src="/sdd-logo.svg" alt="SDD Logo" class="w-8 h-8 group-hover:scale-105 transition-transform duration-200" />
      <div class="flex items-baseline">
        <span class="font-mono font-extrabold text-xl text-sdd-text tracking-tight group-hover:text-sdd-accent transition-colors">SDD</span>
        <span class="font-sans font-light text-lg text-sdd-muted ml-1 tracking-wider">CLI</span>
      </div>
      <span class="hidden sm:inline-block ml-2 px-2 py-0.5 text-[10px] font-mono rounded-full bg-sdd-elevated border border-sdd-border text-sdd-accent">v0.5.0</span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-6">
      <a href={`${homeHref}#features`} class="text-sm text-sdd-muted hover:text-sdd-text transition-colors">
        {isEs ? '¿Por qué SDD?' : 'Why SDD?'}
      </a>
      <a href={`${homeHref}#lifecycle`} class="text-sm text-sdd-muted hover:text-sdd-text transition-colors">
        {isEs ? 'Ciclo de 7 Fases' : '7-Phase Cycle'}
      </a>
      <a href={isEs ? '/es/docs' : '/docs'} class="text-sm text-sdd-accent hover:text-sdd-accent-alt transition-colors font-medium">
        {isEs ? 'Documentación' : 'Docs'}
      </a>
      <a href={`${homeHref}#slash-commands`} class="text-sm text-sdd-muted hover:text-sdd-text transition-colors">
        {isEs ? 'Comandos Slash' : 'Slash Commands'}
      </a>
      
      <!-- GitHub link -->
      <a
        href="https://github.com/dedasema/sdd-cli"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sdd-muted hover:text-sdd-text transition-colors p-1.5 rounded-md hover:bg-sdd-elevated"
        aria-label="GitHub Repository"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- Language Switcher -->
      <LanguageSwitcher currentLang={lang} />
    </nav>

    <!-- Mobile Hamburger Button & Language Switcher -->
    <div class="flex items-center gap-2 md:hidden">
      <LanguageSwitcher currentLang={lang} />
      <button
        id="navbar-mobile-toggle"
        type="button"
        class="p-2 rounded-lg bg-sdd-elevated border border-sdd-border text-sdd-muted hover:text-sdd-text focus:outline-none focus:border-sdd-accent"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="navbar-icon-open" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="navbar-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="navbar-mobile-menu" class="hidden md:hidden border-b border-sdd-border bg-sdd-bg/95 backdrop-blur-lg px-4 pt-3 pb-5 space-y-3">
    <a href={`${homeHref}#features`} class="mobile-nav-link block px-3 py-2 rounded-md text-sm font-mono text-sdd-muted hover:text-sdd-accent hover:bg-sdd-elevated transition-colors">
      {isEs ? '¿Por qué SDD?' : 'Why SDD?'}
    </a>
    <a href={`${homeHref}#lifecycle`} class="mobile-nav-link block px-3 py-2 rounded-md text-sm font-mono text-sdd-muted hover:text-sdd-accent hover:bg-sdd-elevated transition-colors">
      {isEs ? 'Ciclo de 7 Fases' : '7-Phase Cycle'}
    </a>
    <a href={isEs ? '/es/docs' : '/docs'} class="mobile-nav-link block px-3 py-2 rounded-md text-sm font-mono text-sdd-accent bg-sdd-elevated/80 border border-sdd-border hover:border-sdd-accent font-medium">
      {isEs ? '📖 Documentación Oficial' : '📖 Official Docs'}
    </a>
    <a href={`${homeHref}#slash-commands`} class="mobile-nav-link block px-3 py-2 rounded-md text-sm font-mono text-sdd-muted hover:text-sdd-accent hover:bg-sdd-elevated transition-colors">
      {isEs ? 'Comandos Slash' : 'Slash Commands'}
    </a>
    <a
      href="https://github.com/dedasema/sdd-cli"
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-nav-link flex items-center justify-between px-3 py-2 rounded-md text-sm font-mono text-sdd-muted hover:text-sdd-text hover:bg-sdd-elevated transition-colors border border-sdd-border/60"
    >
      <span>GitHub Repository</span>
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
      </svg>
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('navbar-mobile-toggle');
  const menu = document.getElementById('navbar-mobile-menu');
  const iconOpen = document.getElementById('navbar-icon-open');
  const iconClose = document.getElementById('navbar-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && menu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
